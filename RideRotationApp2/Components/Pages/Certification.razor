@page "/certifications"
@rendermode InteractiveServer

@using RideRotationApp2.Models
@using RideRotationApp2.Services
@using RideRotationApp2.Data
@using Microsoft.EntityFrameworkCore

@inject CertificationService Service
@inject AppDbContext Db

<div class="cert-page">
    <div class="top-bar">
        <div class="compact-top-row">
            <h1>Certifications</h1>
            <p>@message</p>
        </div>

        <div class="cert-toolbar">
            <input class="text-input"
                   placeholder="Search person"
                   @bind="nameSearch"
                   @bind:event="oninput" />

            <select class="filter-select" @bind="selectedAreaFilter">
                <option value="">All Home Areas</option>
                @foreach (var area in AllAreas)
                {
                    <option value="@area">@area</option>
                }
            </select>

            <select class="filter-select" @bind="selectedRideFilter">
                <option value="">All Ride Certs</option>
                @foreach (var ride in rides.OrderBy(r => r.Name))
                {
                    <option value="@ride.Name">@ride.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="cert-layout">
        <div class="cert-side-panel">
            <details open class="panel">
                <summary><strong>Add Person</strong></summary>

                <input class="text-input" placeholder="Name" @bind="newEmployeeName" />
                <input class="text-input" placeholder="Home area" @bind="newEmployeeArea" />

                <button class="primary-button" @onclick="AddEmployee">Add Person</button>
            </details>

            <details class="panel">
                <summary><strong>Add Ride</strong></summary>

                <input class="text-input" placeholder="Ride name" @bind="newRideName" />
                <input class="text-input" placeholder="Ride area" @bind="newRideArea" />

                <button class="primary-button" @onclick="AddRide">Add Ride</button>
            </details>

            <details class="panel">
                <summary><strong>Ride Prerequisites</strong></summary>

                @foreach (var ride in rides.OrderBy(r => r.Area).ThenBy(r => r.Name))
                {
                    <div class="cert-prereq-card">
                        <strong>@ride.Name</strong>
                        <div class="muted-text">@ride.Area</div>

                        <select value="@ride.PrerequisiteRideId"
                                @onchange="async e => await SetPrerequisite(ride, e.Value?.ToString())">
                            <option value="">No prerequisite</option>

                            @foreach (var possiblePrereq in rides.Where(r => r.Id != ride.Id).OrderBy(r => r.Name))
                            {
                                <option value="@possiblePrereq.Id">@possiblePrereq.Name</option>
                            }
                        </select>

                        <button class="danger-button" @onclick="() => DeleteRide(ride)">Delete</button>
                    </div>
                }
            </details>
        </div>

        <div class="cert-table-panel">
            @if (employees.Count > 0)
            {
                <div class="cert-table-wrap">
                    <table class="cert-table">
                        <thead>
                            <tr>
                                <th class="sticky-col name-col">Name</th>
                                <th class="sticky-col area-col">Home Area</th>

                                @foreach (var ride in rides.OrderBy(r => r.Area).ThenBy(r => r.Name))
                                {
                                    <th class="ride-col">
                                        <div class="ride-header">
                                            <span>@ride.Name</span>
                                            <small>@ride.Area</small>
                                        </div>
                                    </th>
                                }

                                <th class="action-col">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var employee in FilteredEmployees)
                            {
                                <tr>
                                    <td class="sticky-col name-col">
                                        <strong>@employee.Name</strong>
                                    </td>

                                    <td class="sticky-col area-col">
                                        <input class="area-input"
                                               value="@employee.Area"
                                               @onchange="async e => await UpdateArea(employee, e)" />
                                    </td>

                                    @foreach (var ride in rides.OrderBy(r => r.Area).ThenBy(r => r.Name))
                                    {
                                        var cert = employee.Certifications
                                            .FirstOrDefault(c => c.Ride.Name == ride.Name);

                                        <td class="cert-cell">
                                            @if (cert != null)
                                            {
                                                <input type="checkbox"
                                                       checked="@cert.IsCertified"
                                                       @onchange="async e => await UpdateCertification(cert, e)" />
                                            }
                                        </td>
                                    }

                                    <td class="action-col">
                                        <button class="danger-button" @onclick="() => DeleteEmployee(employee)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="panel">
                    <p>No employees yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string message = "Loading...";

    private List<Employee> employees = new();
    private List<Ride> rides = new();

    private string newEmployeeName = "";
    private string newEmployeeArea = "";

    private string newRideName = "";
    private string newRideArea = "";

    private string nameSearch = "";
    private string selectedAreaFilter = "";
    private string selectedRideFilter = "";

    private List<string> AllAreas =>
        employees
            .Select(e => e.Area)
            .Concat(rides.Select(r => r.Area))
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        employees = await Db.Employees
            .Include(e => e.Certifications)
            .ThenInclude(c => c.Ride)
            .OrderBy(e => e.Name)
            .ToListAsync();

        rides = await Db.Rides
            .Include(r => r.PrerequisiteRide)
            .OrderBy(r => r.Name)
            .ToListAsync();

        message = "Loaded.";
    }

    private IEnumerable<Employee> FilteredEmployees
    {
        get
        {
            var result = employees.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(nameSearch))
            {
                result = result.Where(e =>
                    e.Name.Contains(nameSearch, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedAreaFilter))
            {
                result = result.Where(e =>
                    e.Area.Equals(selectedAreaFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedRideFilter))
            {
                result = result.Where(e =>
                    e.Certifications.Any(c =>
                        c.Ride.Name == selectedRideFilter &&
                        c.IsCertified));
            }

            return result;
        }
    }

    private async Task AddEmployee()
    {
        if (string.IsNullOrWhiteSpace(newEmployeeName))
        {
            message = "Name is required.";
            return;
        }

        if (employees.Any(e => e.Name.Equals(newEmployeeName.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            message = "That person already exists.";
            return;
        }

        await Service.AddEmployee(newEmployeeName.Trim(), newEmployeeArea.Trim(), rides);

        newEmployeeName = "";
        newEmployeeArea = "";

        await LoadData();

        message = "Person added.";
    }

    private async Task AddRide()
    {
        if (string.IsNullOrWhiteSpace(newRideName))
        {
            message = "Ride name is required.";
            return;
        }

        if (rides.Any(r => r.Name.Equals(newRideName.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            message = "That ride already exists.";
            return;
        }

        await Service.AddRide(newRideName.Trim(), newRideArea.Trim(), employees);

        newRideName = "";
        newRideArea = "";

        await LoadData();

        message = "Ride added.";
    }

    private async Task UpdateCertification(EmployeeRideCertification cert, ChangeEventArgs e)
    {
        cert.IsCertified = (bool)e.Value!;
        await Service.SaveChanges();

        message = "Saved certification change.";
    }

    private async Task UpdateArea(Employee employee, ChangeEventArgs e)
    {
        employee.Area = e.Value?.ToString() ?? "";
        await Service.SaveChanges();

        message = "Saved area change.";
    }

    private async Task SetPrerequisite(Ride ride, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            ride.PrerequisiteRideId = null;
        }
        else
        {
            ride.PrerequisiteRideId = int.Parse(value);
        }

        await Db.SaveChangesAsync();
        await LoadData();

        message = $"{ride.Name} prerequisite updated.";
    }

    private async Task DeleteEmployee(Employee employee)
    {
        await Service.DeleteEmployee(employee);
        await LoadData();

        message = $"{employee.Name} deleted.";
    }

    private async Task DeleteRide(Ride ride)
    {
        await Service.DeleteRide(ride);
        await LoadData();

        message = $"{ride.Name} deleted.";
    }
}