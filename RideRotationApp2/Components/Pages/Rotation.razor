@page "/rotation"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using RideRotationApp2.Data
@using RideRotationApp2.Models
@using RideRotationApp2.Services

@inject NextShiftService NextShiftService
@inject AppDbContext Db
@inject RotationService RotationService

<div class="rotation-page">
    <div class="top-bar">
        <h1>Rotation Builder</h1>
        <p>@message</p>

        <div class="area-tabs">
            @foreach (var area in areas)
            {
                <button class="tab-button @(selectedArea == area ? "active" : "")"
                        @onclick="() => SelectArea(area)">
                    @area
                </button>
            }
        </div>

        <div class="view-tabs">
            <button class="tab-button @(selectedView == "setup" ? "active" : "")"
                    @onclick='() => selectedView = "setup"'>
                Setup
            </button>

            @if (currentResult.Assignments.Count > 0)
            {
                <button class="tab-button @(selectedView == "rotation" ? "active" : "")"
                        @onclick='() => selectedView = "rotation"'>
                    Rotation 1
                </button>

                @for (int i = 0; i < nextShifts.Count; i++)
                {
                    int shiftIndex = i;
                    string viewName = $"shift-{shiftIndex}";

                    <button class="tab-button @(selectedView == viewName ? "active" : "")"
                            @onclick="() => selectedView = viewName">
                        Shift @(shiftIndex + 2)
                    </button>
                }
            }
        </div>

        <div class="action-row">
            <button class="primary-button" @onclick="GenerateRotation">Generate Rotation</button>

            @if (currentResult.Assignments.Count > 0)
            {
                <button class="primary-button" @onclick="GenerateNextShift">+ Next Shift</button>
                <button class="secondary-button" @onclick="SaveRotation">Save Rotation</button>
            }

            <button class="danger-button" @onclick="ResetRotation">Reset</button>
        </div>
    </div>

    @if (currentResult.Warnings.Count > 0)
    {
        <div class="warning-red">
            <strong>Rotation Warnings</strong>

            @foreach (var warning in currentResult.Warnings)
            {
                <div>@warning</div>
            }
        </div>
    }

    @if (nextShiftWarnings.Count > 0)
    {
        <div class="warning-orange">
            <strong>Next Shift Warnings</strong>

            @foreach (var warning in nextShiftWarnings)
            {
                <div>@warning</div>
            }
        </div>
    }

    @if (selectedView == "setup")
    {
        <div class="layout">
            <div>
                <div class="panel">
                    <h3>@selectedArea Employees Working Today</h3>

                    <div class="action-row">
                        <button class="secondary-button" @onclick="SelectAllAreaEmployees">Select All</button>
                        <button class="secondary-button" @onclick="ClearAreaEmployees">Clear</button>
                    </div>

                    <div class="check-list">
                        @foreach (var employee in AreaEmployees)
                        {
                            <label>
                                <input type="checkbox" @bind="pageState.SelectedEmployeeIds[employee.Id]" />
                                @employee.Name
                            </label>
                        }
                    </div>
                </div>

                <div class="panel">
                    <h3>@selectedArea Open Rides</h3>

                    <div class="action-row">
                        <button class="secondary-button" @onclick="SelectAllAreaRides">Select All</button>
                        <button class="secondary-button" @onclick="ClearAreaRides">Clear</button>
                    </div>

                    <div class="check-list">
                        @foreach (var ride in AreaRides)
                        {
                            <label>
                                <input type="checkbox" @bind="pageState.SelectedRideIds[ride.Id]" />
                                @ride.Name
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div>
                <div class="panel">
                    <h3>Breakers</h3>

                    <div class="count-control">
                        <button class="secondary-button" @onclick="DecreaseBreakers">-</button>
                        <span class="count-number">@breakerCount</span>
                        <button class="secondary-button" @onclick="IncreaseBreakers">+</button>
                    </div>
                </div>

                <div class="panel">
                    <h3>Can't Be Breaker</h3>

                    <div class="check-list">
                        @foreach (var employee in AreaEmployees)
                        {
                            <label>
                                <input type="checkbox" @bind="pageState.CannotBeBreakerIds[employee.Id]" />
                                @employee.Name
                            </label>
                        }
                    </div>
                </div>

                <div class="panel">
                    <h3>Training Requests</h3>

                    <button class="secondary-button" @onclick="AddTrainingRequest">+ Add Training</button>

                    @for (int i = 0; i < pageState.TrainingRequests.Count; i++)
                    {
                        int index = i;

                        <div class="rotation-card">
                            <strong>Training @(index + 1)</strong>

                            <div>
                                Person:
                                <select @bind="pageState.TrainingRequests[index].EmployeeId">
                                    <option value="">Any</option>
                                    @foreach (var employee in AreaEmployees)
                                    {
                                        <option value="@employee.Id">@employee.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                Ride:
                                <select @bind="pageState.TrainingRequests[index].RideId">
                                    <option value="">Any</option>
                                    @foreach (var ride in AreaRides)
                                    {
                                        <option value="@ride.Id">@ride.Name</option>
                                    }
                                </select>
                            </div>

                            <br />
                            <button class="danger-button" @onclick="() => RemoveTrainingRequest(index)">Remove</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (selectedView == "rotation" && currentResult.Assignments.Count > 0)
    {
        <h2>Rotation 1 - @selectedArea</h2>

        @foreach (var item in OrderedCurrentAssignments)
        {
            <div class="rotation-card">
                <strong>@item.Ride.Name</strong>
                <br />
                @item.Employee.Name

                @if (item.IsTraining)
                {
                    <span> (Training)</span>
                }
            </div>
        }

        @if (currentResult.Breakers.Count > 0)
        {
            <h2>Breakers</h2>

            @for (int i = 0; i < currentResult.Breakers.Count; i++)
            {
                var breaker = currentResult.Breakers[i];

                <div class="rotation-card">
                    <strong>Breaker @(i + 1): @breaker.Name</strong>

                    <div>
                        Covers:
                        @{
                            var coverage = currentResult.BreakerCoverage.GetValueOrDefault(breaker.Id, new List<Ride>());
                        }

                        @if (coverage.Count == 0)
                        {
                            <span>None</span>
                        }
                        else
                        {
                            <span>@string.Join(", ", coverage.Select(r => r.Name))</span>
                        }
                    </div>
                </div>
            }
        }

        <div class="panel">
            <h3>Next Shift Training Requests</h3>

            <button class="secondary-button" @onclick="AddNextShiftTrainingRequest">+ Add Training</button>

            @for (int i = 0; i < pageState.NextShiftTrainingRequests.Count; i++)
            {
                int index = i;

                <div class="rotation-card">
                    <strong>Next Shift Training @(index + 1)</strong>

                    <div>
                        Person:
                        <select @bind="pageState.NextShiftTrainingRequests[index].EmployeeId">
                            <option value="">Any</option>
                            @foreach (var employee in AreaEmployees)
                            {
                                <option value="@employee.Id">@employee.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        Ride:
                        <select @bind="pageState.NextShiftTrainingRequests[index].RideId">
                            <option value="">Any</option>
                            @foreach (var ride in AreaRides)
                            {
                                <option value="@ride.Id">@ride.Name</option>
                            }
                        </select>
                    </div>

                    <br />
                    <button class="danger-button" @onclick="() => RemoveNextShiftTrainingRequest(index)">Remove</button>
                </div>
            }
        </div>
    }

    @for (int i = 0; i < nextShifts.Count; i++)
    {
        int shiftIndex = i;

        if (selectedView == $"shift-{shiftIndex}")
        {
            <h2>Shift @(shiftIndex + 2)</h2>

            <button class="danger-button" @onclick="() => DeleteShift(shiftIndex)">Reset This Shift</button>

            <br />
            <br />

            @foreach (var move in nextShifts[shiftIndex])
            {
                <div class="rotation-card">
                    @if (move.FromPosition.StartsWith("Breaker", StringComparison.OrdinalIgnoreCase))
                    {
                        <strong>Breaker: @move.EmployeeName</strong>
                    }
                    else
                    {
                        <strong>@move.EmployeeName</strong>
                    }

                    <div>@move.FromPosition → @move.ToPosition</div>

                    @if (move.IsTraining)
                    {
                        <span>Training</span>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private string message = "Select employees and rides.";

    private List<Employee> employees = new();
    private List<Ride> rides = new();

    private RotationPageState pageState = new();

    private RotationGenerationResult currentResult = new();

    private int breakerCount = 0;

    private string selectedArea = "Alpha";
    private string selectedView = "setup";

    private List<string> areas = new()
    {
        "Alpha",
        "Bravo",
        "Charlie",
        "Delta"
    };

    private List<string> whiteboardRideOrder = new()
    {
        "FWL",
        "FWP",
        "SLL",
        "SLP",
        "SBL",
        "SBP",
        "RR",
        "TOR",
        "CAS",
        "TL"
    };

    private List<List<NextShiftMove>> nextShifts = new();
    private List<ShiftSnapshot> shiftSnapshots = new();
    private List<string> nextShiftWarnings = new();

    private List<Employee> AreaEmployees =>
        employees
            .Where(e => AreaMatches(e.Area))
            .OrderBy(e => e.Name)
            .ToList();

    private List<Ride> AreaRides =>
        rides
            .Where(r => AreaMatches(r.Area))
            .OrderBy(r => GetRideDisplayOrder(r.Name))
            .ThenBy(r => r.Name)
            .ToList();

    private List<RotationResultItem> OrderedCurrentAssignments =>
        currentResult.Assignments
            .Where(a => AreaMatches(a.Ride.Area))
            .OrderBy(a => GetRideDisplayOrder(a.Ride.Name))
            .ThenBy(a => a.Ride.Name)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        employees = await Db.Employees
            .Include(e => e.Certifications)
            .ThenInclude(c => c.Ride)
            .OrderBy(e => e.Name)
            .ToListAsync();

        rides = await Db.Rides
            .Include(r => r.PrerequisiteRide)
            .OrderBy(r => r.Name)
            .ToListAsync();

        pageState.Initialize(employees, rides);
    }

    private void SelectArea(string area)
    {
        selectedArea = area;
        selectedView = "setup";
        ResetRotation();
    }

    private bool AreaMatches(string? area)
    {
        return string.Equals(area, selectedArea, StringComparison.OrdinalIgnoreCase);
    }

    private int GetRideDisplayOrder(string rideName)
    {
        int index = whiteboardRideOrder.FindIndex(r =>
            r.Equals(rideName, StringComparison.OrdinalIgnoreCase));

        return index == -1 ? 999 : index;
    }

    private void SelectAllAreaEmployees()
    {
        foreach (var employee in AreaEmployees)
            pageState.SelectedEmployeeIds[employee.Id] = true;
    }

    private void ClearAreaEmployees()
    {
        foreach (var employee in AreaEmployees)
            pageState.SelectedEmployeeIds[employee.Id] = false;
    }

    private void SelectAllAreaRides()
    {
        foreach (var ride in AreaRides)
            pageState.SelectedRideIds[ride.Id] = true;
    }

    private void ClearAreaRides()
    {
        foreach (var ride in AreaRides)
            pageState.SelectedRideIds[ride.Id] = false;
    }

    private void IncreaseBreakers()
    {
        breakerCount++;
    }

    private void DecreaseBreakers()
    {
        if (breakerCount > 0)
            breakerCount--;
    }

    private void AddTrainingRequest()
    {
        pageState.TrainingRequests.Add(new TrainingRequest());
    }

    private void RemoveTrainingRequest(int index)
    {
        if (index >= 0 && index < pageState.TrainingRequests.Count)
            pageState.TrainingRequests.RemoveAt(index);
    }

    private void AddNextShiftTrainingRequest()
    {
        pageState.NextShiftTrainingRequests.Add(new TrainingRequest());
    }

    private void RemoveNextShiftTrainingRequest(int index)
    {
        if (index >= 0 && index < pageState.NextShiftTrainingRequests.Count)
            pageState.NextShiftTrainingRequests.RemoveAt(index);
    }

    private async Task GenerateRotation()
    {
        nextShiftWarnings.Clear();
        nextShifts.Clear();
        shiftSnapshots.Clear();

        var selectedEmployees = AreaEmployees
            .Where(e => pageState.SelectedEmployeeIds.GetValueOrDefault(e.Id))
            .ToList();

        var selectedRides = AreaRides
            .Where(r => pageState.SelectedRideIds.GetValueOrDefault(r.Id))
            .ToList();

        var cannotBeBreakerEmployeeIds = AreaEmployees
            .Where(e => pageState.CannotBeBreakerIds.GetValueOrDefault(e.Id))
            .Select(e => e.Id)
            .ToList();

        currentResult = await RotationService.GenerateRotation(
            selectedEmployees,
            selectedRides,
            pageState.TrainingRequests,
            breakerCount,
            cannotBeBreakerEmployeeIds);

        selectedView = "rotation";
        message = $"Generated {currentResult.Assignments.Count} ride assignments and {currentResult.Breakers.Count} breakers.";
    }

    private async Task SaveRotation()
    {
        await RotationService.SaveRotation(currentResult.Assignments);
        message = "Rotation saved.";
    }

    private void ResetRotation()
    {
        currentResult = new RotationGenerationResult();
        nextShifts.Clear();
        shiftSnapshots.Clear();
        nextShiftWarnings.Clear();
        selectedView = "setup";
        message = "Rotation reset.";
    }

    private void GenerateNextShift()
    {
        nextShiftWarnings.Clear();

        if (currentResult.Assignments.Count == 0)
        {
            message = "Generate a rotation first.";
            return;
        }

        var activeEmployeeIds = AreaEmployees
            .Where(e => pageState.SelectedEmployeeIds.GetValueOrDefault(e.Id))
            .Select(e => e.Id)
            .ToHashSet();

        var result = NextShiftService.GenerateNextShift(
            currentResult,
            employees,
            rides,
            shiftSnapshots,
            activeEmployeeIds,
            pageState.NextShiftTrainingRequests);

        if (!result.Success)
        {
            nextShiftWarnings = result.Warnings;
            message = "Next shift could not be generated.";
            return;
        }

        if (result.StartingSnapshot != null && shiftSnapshots.Count == 0)
        {
            shiftSnapshots.Add(result.StartingSnapshot);
        }

        nextShifts.Add(result.Moves);
        shiftSnapshots.Add(result.Snapshot);

        selectedView = $"shift-{nextShifts.Count - 1}";
        message = $"Generated Shift {nextShifts.Count + 1}.";
    }

    private void DeleteShift(int index)
    {
        if (index < 0 || index >= nextShifts.Count)
            return;

        nextShifts.RemoveAt(index);

        int snapshotIndex = index + 1;

        if (snapshotIndex >= 0 && snapshotIndex < shiftSnapshots.Count)
        {
            shiftSnapshots.RemoveRange(snapshotIndex, shiftSnapshots.Count - snapshotIndex);
        }

        selectedView = nextShifts.Count > 0 ? $"shift-{Math.Min(index, nextShifts.Count - 1)}" : "rotation";
        message = $"Deleted Shift {index + 2}. Any later shifts were also removed.";
    }
}