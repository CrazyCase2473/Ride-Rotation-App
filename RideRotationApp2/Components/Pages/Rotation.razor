@page "/rotation"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using RideRotationApp2.Data
@using RideRotationApp2.Models
@using RideRotationApp2.Services

@inject NextShiftService NextShiftService
@inject AppDbContext Db
@inject RotationService RotationService

<h1>Rotation Builder</h1>

<p>@message</p>

@if (currentResult.Warnings.Count > 0)
{
    <div style="border:1px solid red; padding:10px; margin:10px 0;">
        <strong>Rotation Warnings</strong>

        @foreach (var warning in currentResult.Warnings)
        {
            <div>@warning</div>
        }
    </div>
}

@if (nextShiftWarnings.Count > 0)
{
    <div style="border:1px solid orange; padding:10px; margin:10px 0;">
        <strong>Next Shift Warnings</strong>

        @foreach (var warning in nextShiftWarnings)
        {
            <div>@warning</div>
        }
    </div>
}

<h3>Training Count</h3>
<input type="number"
       min="0"
       value="@trainingCount"
       @onchange="TrainingCountChanged" />

@if (trainingCount > 0)
{
    <h4>Training Requests</h4>

    @for (int i = 0; i < trainingRequests.Count; i++)
    {
        int index = i;

        <div style="border:1px solid #ccc; padding:8px; margin:6px 0;">
            <strong>Training @(index + 1)</strong>

            <div>
                Person:
                <select @bind="trainingRequests[index].EmployeeId">
                    <option value="">Any</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.Id">@employee.Name</option>
                    }
                </select>
            </div>

            <div>
                Ride:
                <select @bind="trainingRequests[index].RideId">
                    <option value="">Any</option>
                    @foreach (var ride in rides)
                    {
                        <option value="@ride.Id">@ride.Name</option>
                    }
                </select>
            </div>
        </div>
    }
}

<h3>Breaker Count</h3>
<input type="number" @bind="breakerCount" min="0" />

<details open>
    <summary><strong>Working Today</strong></summary>

    @foreach (var employee in employees)
    {
        <label style="display:block;">
            <input type="checkbox" @bind="selectedEmployeeIds[employee.Id]" />
            @employee.Name (@employee.Area)
        </label>
    }
</details>

<details>
    <summary><strong>Can't Be Breaker</strong></summary>

    @foreach (var employee in employees)
    {
        <label style="display:block;">
            <input type="checkbox" @bind="cannotBeBreakerIds[employee.Id]" />
            @employee.Name
        </label>
    }
</details>

<details open>
    <summary><strong>Open Rides</strong></summary>

    @foreach (var ride in rides)
    {
        <label style="display:block;">
            <input type="checkbox" @bind="selectedRideIds[ride.Id]" />
            @ride.Name
        </label>
    }
</details>

<br />

<button @onclick="GenerateRotation">Generate Rotation</button>
<button @onclick="ResetRotation">Reset</button>

@if (currentResult.Assignments.Count > 0)
{
    <h2>Generated Rotation</h2>

    @foreach (var item in currentResult.Assignments)
    {
        <div style="border:1px solid #ccc; padding:10px; margin:8px 0;">
            <strong>@item.Ride.Name</strong>
            <br />
            @item.Employee.Name

            @if (item.IsTraining)
            {
                <span> (Training)</span>
            }
        </div>
    }

    @if (currentResult.Breakers.Count > 0)
    {
        <h2>Breakers</h2>

        @for (int i = 0; i < currentResult.Breakers.Count; i++)
        {
            var breaker = currentResult.Breakers[i];

            <div style="border:1px solid #aaa; padding:10px; margin:8px 0;">
                <strong>Breaker @(i + 1): @breaker.Name</strong>

                <div>
                    Covers:
                    @{
                        var coverage = currentResult.BreakerCoverage.GetValueOrDefault(breaker.Id, new List<Ride>());
                    }

                    @if (coverage.Count == 0)
                    {
                        <span>None</span>
                    }
                    else
                    {
                        <span>@string.Join(", ", coverage.Select(r => r.Name))</span>
                    }
                </div>
            </div>
        }
    }

    <button @onclick="SaveRotation">Save Rotation</button>

    <h2>Next Shift Setup</h2>

    <h3>Next Shift Training Count</h3>
    <input type="number"
           min="0"
           value="@nextShiftTrainingCount"
           @onchange="NextShiftTrainingCountChanged" />

    @if (nextShiftTrainingCount > 0)
    {
        <h4>Next Shift Training Requests</h4>

        @for (int i = 0; i < nextShiftTrainingRequests.Count; i++)
        {
            int index = i;

            <div style="border:1px solid #ccc; padding:8px; margin:6px 0;">
                <strong>Next Shift Training @(index + 1)</strong>

                <div>
                    Person:
                    <select @bind="nextShiftTrainingRequests[index].EmployeeId">
                        <option value="">Any</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@employee.Name</option>
                        }
                    </select>
                </div>

                <div>
                    Ride:
                    <select @bind="nextShiftTrainingRequests[index].RideId">
                        <option value="">Any</option>
                        @foreach (var ride in rides)
                        {
                            <option value="@ride.Id">@ride.Name</option>
                        }
                    </select>
                </div>
            </div>
        }
    }

    <br />
    <button @onclick="GenerateNextShift">Next Shift</button>
}

@if (nextShifts.Count > 0)
{
    <h2>Next Shifts</h2>

    @for (int i = 0; i < nextShifts.Count; i++)
    {
        int shiftIndex = i;

        <div style="border:2px solid #666; padding:10px; margin:10px 0;">
            <h3>Shift @(shiftIndex + 2)</h3>

            <button @onclick="() => DeleteShift(shiftIndex)">Reset This Shift</button>

            @foreach (var move in nextShifts[shiftIndex])
            {
                <div>
                    @if (move.FromPosition.StartsWith("Breaker", StringComparison.OrdinalIgnoreCase))
                    {
                        <strong>Breaker: @move.EmployeeName</strong>
                    }
                    else
                    {
                        <strong>@move.EmployeeName</strong>
                    }

                    :
                    @move.FromPosition → @move.ToPosition

                    @if (move.IsTraining)
                    {
                        <span> (Training)</span>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private string message = "Select employees and rides.";

    private List<Employee> employees = new();
    private List<Ride> rides = new();

    private Dictionary<int, bool> selectedEmployeeIds = new();
    private Dictionary<int, bool> selectedRideIds = new();
    private Dictionary<int, bool> cannotBeBreakerIds = new();

    private RotationGenerationResult currentResult = new();

    private int trainingCount = 0;
    private int breakerCount = 0;
    private int nextShiftTrainingCount = 0;

    private List<TrainingRequest> trainingRequests = new();
    private List<TrainingRequest> nextShiftTrainingRequests = new();

    private List<List<NextShiftMove>> nextShifts = new();
    private List<ShiftSnapshot> shiftSnapshots = new();
    private List<string> nextShiftWarnings = new();

    protected override async Task OnInitializedAsync()
    {
        employees = await Db.Employees
            .Include(e => e.Certifications)
            .ThenInclude(c => c.Ride)
            .OrderBy(e => e.Name)
            .ToListAsync();

        rides = await Db.Rides
            .Include(r => r.PrerequisiteRide)
            .OrderBy(r => r.Name)
            .ToListAsync();

        foreach (var employee in employees)
        {
            selectedEmployeeIds[employee.Id] = true;
            cannotBeBreakerIds[employee.Id] = false;
        }

        foreach (var ride in rides)
        {
            selectedRideIds[ride.Id] = true;
        }

        SyncTrainingRequests();
    }

    private void TrainingCountChanged(ChangeEventArgs e)
    {
        trainingCount = int.Parse(e.Value?.ToString() ?? "0");
        SyncTrainingRequests();
    }

    private void NextShiftTrainingCountChanged(ChangeEventArgs e)
    {
        nextShiftTrainingCount = int.Parse(e.Value?.ToString() ?? "0");
        SyncTrainingRequests();
    }

    private void SyncTrainingRequests()
    {
        while (trainingRequests.Count < trainingCount)
            trainingRequests.Add(new TrainingRequest());

        while (trainingRequests.Count > trainingCount)
            trainingRequests.RemoveAt(trainingRequests.Count - 1);

        while (nextShiftTrainingRequests.Count < nextShiftTrainingCount)
            nextShiftTrainingRequests.Add(new TrainingRequest());

        while (nextShiftTrainingRequests.Count > nextShiftTrainingCount)
            nextShiftTrainingRequests.RemoveAt(nextShiftTrainingRequests.Count - 1);
    }

    private async Task GenerateRotation()
    {
        nextShiftWarnings.Clear();
        nextShifts.Clear();
        shiftSnapshots.Clear();

        SyncTrainingRequests();

        var selectedEmployees = employees
            .Where(e => selectedEmployeeIds.GetValueOrDefault(e.Id))
            .ToList();

        var selectedRides = rides
            .Where(r => selectedRideIds.GetValueOrDefault(r.Id))
            .ToList();

        var cannotBeBreakerEmployeeIds = cannotBeBreakerIds
            .Where(pair => pair.Value)
            .Select(pair => pair.Key)
            .ToList();

        currentResult = await RotationService.GenerateRotation(
            selectedEmployees,
            selectedRides,
            trainingRequests,
            breakerCount,
            cannotBeBreakerEmployeeIds);

        message = $"Generated {currentResult.Assignments.Count} ride assignments and {currentResult.Breakers.Count} breakers.";
    }

    private async Task SaveRotation()
    {
        await RotationService.SaveRotation(currentResult.Assignments);
        message = "Rotation saved.";
    }

    private void ResetRotation()
    {
        currentResult = new RotationGenerationResult();
        nextShifts.Clear();
        shiftSnapshots.Clear();
        nextShiftWarnings.Clear();
        message = "Rotation reset.";
    }

    private void GenerateNextShift()
    {
        nextShiftWarnings.Clear();

        if (currentResult.Assignments.Count == 0)
        {
            message = "Generate a rotation first.";
            return;
        }

        SyncTrainingRequests();

        var activeEmployeeIds = selectedEmployeeIds
            .Where(pair => pair.Value)
            .Select(pair => pair.Key)
            .ToHashSet();

        var result = NextShiftService.GenerateNextShift(
            currentResult,
            employees,
            rides,
            shiftSnapshots,
            activeEmployeeIds,
            nextShiftTrainingRequests);

        if (!result.Success)
        {
            nextShiftWarnings = result.Warnings;
            message = "Next shift could not be generated.";
            return;
        }

        if (result.StartingSnapshot != null && shiftSnapshots.Count == 0)
        {
            shiftSnapshots.Add(result.StartingSnapshot);
        }

        nextShifts.Add(result.Moves);
        shiftSnapshots.Add(result.Snapshot);

        message = $"Generated Shift {nextShifts.Count + 1}.";
    }

    private List<List<List<string>>> BuildPossibleAutomaticRotationLineSets(
        List<string> ridePositions,
        List<string> breakerPositions)
    {
        var lineSets = new List<List<List<string>>>();

        if (ridePositions.Count == 0)
            return lineSets;

        if (breakerPositions.Count == 0)
        {
            lineSets.Add(new List<List<string>> { ridePositions.ToList() });
            return lineSets;
        }

        if (breakerPositions.Count == 1)
        {
            lineSets.Add(new List<List<string>>
            {
                new List<string> { breakerPositions[0] }
                    .Concat(ridePositions)
                    .ToList()
            });

            return lineSets;
        }

        if (breakerPositions.Count == 2)
        {
            foreach (var firstGroup in GetRideGroupsNearTargetSize(ridePositions, 4))
            {
                var secondGroup = ridePositions
                    .Where(r => !firstGroup.Contains(r))
                    .ToList();

                if (secondGroup.Count == 0)
                    continue;

                lineSets.Add(new List<List<string>>
                {
                    new List<string> { breakerPositions[0] }.Concat(firstGroup).ToList(),
                    new List<string> { breakerPositions[1] }.Concat(secondGroup).ToList()
                });

                lineSets.Add(new List<List<string>>
                {
                    new List<string> { breakerPositions[0] }.Concat(secondGroup).ToList(),
                    new List<string> { breakerPositions[1] }.Concat(firstGroup).ToList()
                });
            }

            return lineSets;
        }

        var groups = new List<List<string>>();

        for (int i = 0; i < breakerPositions.Count; i++)
            groups.Add(new List<string> { breakerPositions[i] });

        for (int i = 0; i < ridePositions.Count; i++)
            groups[i % breakerPositions.Count].Add(ridePositions[i]);

        lineSets.Add(groups);
        return lineSets;
    }

    private List<List<string>> GetRideGroupsNearTargetSize(List<string> ridesToSplit, int targetSize)
    {
        var groups = new List<List<string>>();

        int minSize = Math.Max(1, targetSize - 1);
        int maxSize = Math.Min(ridesToSplit.Count - 1, targetSize + 1);

        for (int size = minSize; size <= maxSize; size++)
        {
            BuildCombinations(ridesToSplit, size, 0, new List<string>(), groups);
        }

        return groups
            .OrderBy(g => Math.Abs(g.Count - targetSize))
            .ThenBy(g => string.Join(",", g))
            .ToList();
    }

    private void BuildCombinations(
        List<string> source,
        int size,
        int startIndex,
        List<string> current,
        List<List<string>> results)
    {
        if (current.Count == size)
        {
            results.Add(current.ToList());
            return;
        }

        for (int i = startIndex; i < source.Count; i++)
        {
            current.Add(source[i]);
            BuildCombinations(source, size, i + 1, current, results);
            current.RemoveAt(current.Count - 1);
        }
    }

    private bool TryBuildBestLineMoves(
        List<string> linePositions,
        ShiftSnapshot currentSnapshot,
        ShiftSnapshot nextSnapshot,
        List<NextShiftMove> allMoves,
        List<TrainingRequest> availableTrainingRequests)
    {
        var positionsInLine = linePositions
            .Where(p => currentSnapshot.Positions.ContainsKey(p))
            .ToList();

        if (positionsInLine.Count < 2)
            return false;

        var activeEmployeeIds = selectedEmployeeIds
            .Where(pair => pair.Value)
            .Select(pair => pair.Key)
            .ToHashSet();

        var possibleOrders = GetPositionPermutations(positionsInLine, maxResults: 5000);

        foreach (var order in possibleOrders)
        {
            var testMoves = new List<NextShiftMove>();

            var testSnapshot = new ShiftSnapshot
            {
                Positions = new Dictionary<string, string>(nextSnapshot.Positions),
                TrainingStatus = new Dictionary<string, bool>(nextSnapshot.TrainingStatus)
            };

            var testAvailableRequests = availableTrainingRequests.ToList();

            bool worked = true;

            for (int i = 0; i < order.Count; i++)
            {
                string fromPosition = order[i];
                string toPosition = order[(i + 1) % order.Count];

                string employeeName = currentSnapshot.Positions[fromPosition];

                var employee = employees.FirstOrDefault(e =>
                    e.Name.Equals(employeeName, StringComparison.OrdinalIgnoreCase));

                if (employee == null || !activeEmployeeIds.Contains(employee.Id))
                {
                    worked = false;
                    break;
                }

                bool isTraining = false;

                if (!CanMoveToPosition(employee, toPosition, testAvailableRequests, out isTraining, out var usedRequest))
                {
                    worked = false;
                    break;
                }

                if (usedRequest != null)
                    testAvailableRequests.Remove(usedRequest);

                testMoves.Add(new NextShiftMove
                {
                    EmployeeName = employee.Name,
                    FromPosition = fromPosition,
                    ToPosition = toPosition,
                    IsTraining = isTraining
                });

                testSnapshot.Positions[toPosition] = employee.Name;
                testSnapshot.TrainingStatus[toPosition] = isTraining;
            }

            if (worked)
            {
                availableTrainingRequests.Clear();
                availableTrainingRequests.AddRange(testAvailableRequests);

                foreach (var move in testMoves)
                    allMoves.Add(move);

                foreach (var pair in testSnapshot.Positions)
                    nextSnapshot.Positions[pair.Key] = pair.Value;

                foreach (var pair in testSnapshot.TrainingStatus)
                    nextSnapshot.TrainingStatus[pair.Key] = pair.Value;

                return true;
            }
        }

        return false;
    }

    private List<List<string>> GetPositionPermutations(List<string> positions, int maxResults)
    {
        var results = new List<List<string>>();

        void Backtrack(List<string> current, List<string> remaining)
        {
            if (results.Count >= maxResults)
                return;

            if (remaining.Count == 0)
            {
                results.Add(current.ToList());
                return;
            }

            foreach (var position in remaining.ToList())
            {
                current.Add(position);

                var nextRemaining = remaining
                    .Where(p => p != position)
                    .ToList();

                Backtrack(current, nextRemaining);

                current.RemoveAt(current.Count - 1);
            }
        }

        Backtrack(new List<string>(), positions);

        return results;
    }

    private bool CanMoveToPosition(
        Employee employee,
        string toPosition,
        List<TrainingRequest> availableTrainingRequests,
        out bool isTraining,
        out TrainingRequest? usedTrainingRequest)
    {
        isTraining = false;
        usedTrainingRequest = null;

        if (IsBreakerPosition(toPosition))
            return true;

        var ride = FindRideByName(toPosition);

        if (ride == null)
            return false;

        if (IsCertified(employee, ride))
            return true;

        var matchingRequest = availableTrainingRequests.FirstOrDefault(request =>
            (request.EmployeeId == null || request.EmployeeId == employee.Id) &&
            (request.RideId == null || request.RideId == ride.Id));

        if (matchingRequest != null && CanTrainOnRide(employee, ride))
        {
            isTraining = true;
            usedTrainingRequest = matchingRequest;
            return true;
        }

        return false;
    }

    private ShiftSnapshot BuildSnapshotFromCurrentRotation()
    {
        var snapshot = new ShiftSnapshot();

        foreach (var assignment in currentResult.Assignments)
        {
            snapshot.Positions[assignment.Ride.Name] = assignment.Employee.Name;
            snapshot.TrainingStatus[assignment.Ride.Name] = assignment.IsTraining;
        }

        for (int i = 0; i < currentResult.Breakers.Count; i++)
        {
            string breakerPosition = $"Breaker {i + 1}";
            snapshot.Positions[breakerPosition] = currentResult.Breakers[i].Name;
            snapshot.TrainingStatus[breakerPosition] = false;
        }

        return snapshot;
    }

    private void DeleteShift(int index)
    {
        if (index < 0 || index >= nextShifts.Count)
            return;

        nextShifts.RemoveAt(index);

        int snapshotIndex = index + 1;

        if (snapshotIndex >= 0 && snapshotIndex < shiftSnapshots.Count)
        {
            shiftSnapshots.RemoveRange(snapshotIndex, shiftSnapshots.Count - snapshotIndex);
        }

        message = $"Deleted Shift {index + 2}. Any later shifts were also removed.";
    }

    private Ride? FindRideByName(string rideName)
    {
        return rides.FirstOrDefault(r =>
            r.Name.Equals(rideName, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsBreakerPosition(string position)
    {
        return position.StartsWith("Breaker", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCertified(Employee employee, Ride ride)
    {
        return employee.Certifications.Any(cert =>
            cert.RideId == ride.Id &&
            cert.IsCertified);
    }

    private bool CanTrainOnRide(Employee employee, Ride ride)
    {
        if (ride.PrerequisiteRideId == null)
            return true;

        return employee.Certifications.Any(cert =>
            cert.RideId == ride.PrerequisiteRideId &&
            cert.IsCertified);
    }
}